# Copy this file to `.streamlit/secrets.toml` for local use,
# or paste the same values into the Streamlit Cloud Secrets panel.

ENV = "production"

CLIENT_ID = "replace-me"
TENANT_ID = "replace-me"
CLIENT_SECRET = "replace-me"
REDIRECT_URI = "https://your-app-name.streamlit.app/"

SP_HOSTNAME = "groupcastillo.sharepoint.com"
SP_SITE_PATH = "/sites/GroupCastilloTeamSite"
SP_DRIVE_NAME = "Documents"

PAGOS_PERIODOS_WORKBOOK_PATH = "General/12433087 CANADA INC-MASTER/09-Pagos Periodos/2025/Building & Contractor Pay List/Building Address & Contractor Pay List.xlsx"
WORK98_TEMPLATE_PATH = ""
WORK98_TEMPLATE_LOCAL_PATH = ""
WORK98_TEMPLATE_FILENAME = ""
WORK98_USE_SAMPLE_DATA = false
JOB_SOURCE_TIMEZONE = "UTC"
DEFAULT_BUILDING_TIMEZONE = "America/Toronto"

DB_HOST = "replace-me"
DB_PORT = 25060
DB_USER = "replace-me"
DB_PASS = "replace-me"
DB_NAME = "replace-me"
DB_HOST_READ = "replace-me"
DB_PORT_READ = 25060
DB_USER_READ = "replace-me"
DB_PASS_READ = "replace-me"
DB_NAME_READ = "replace-me"
DB_HOST_WRITE = "replace-me"
DB_PORT_WRITE = 25060
DB_USER_WRITE = "replace-me"
DB_PASS_WRITE = "replace-me"
DB_NAME_WRITE = "replace-me"

SSH_TUNNEL_ENABLED = true
SSH_TUNNEL_HOST = "replace-me"
SSH_TUNNEL_PORT = 22
SSH_TUNNEL_USER = "replace-me"
SSH_TUNNEL_KEY_PASSPHRASE = ""
SSH_TUNNEL_REMOTE_HOST = "replace-me"
SSH_TUNNEL_REMOTE_PORT = 25060
SSH_TUNNEL_REMOTE_HOST_READ = "replace-me"
SSH_TUNNEL_REMOTE_PORT_READ = 25060
SSH_TUNNEL_REMOTE_HOST_WRITE = "replace-me"
SSH_TUNNEL_REMOTE_PORT_WRITE = 25060
SSH_TUNNEL_LOCAL_HOST = "127.0.0.1"

# Use only one auth mode:
# 1) Password auth
SSH_TUNNEL_PASSWORD = ""

# 2) Key auth from an inline private key stored in secrets
SSH_TUNNEL_PRIVATE_KEY = """
-----BEGIN OPENSSH PRIVATE KEY-----
replace-me
-----END OPENSSH PRIVATE KEY-----
"""

# Optional. Only needed if your MySQL provider requires a custom CA bundle.
DO_MYSQL_CA_PEM = """
-----BEGIN CERTIFICATE-----
replace-me
-----END CERTIFICATE-----
"""
